# Copy this file to .env only for local development. Never commit real credentials.
DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# Set to the final https domain once connected. Leave empty initially on Railway.
SITE_URL=
# Additional hostnames and their matching CSRF origins, if needed.
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# SumUp Hosted Checkout (enable after adding the matching production credentials).
CARD_PAYMENTS_ENABLED=true
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=

# Direct SEPA transfers are credited only after bank receipt is confirmed in admin.
BANK_TRANSFER_ACCOUNT_HOLDER=
BANK_TRANSFER_IBAN=
BANK_TRANSFER_BIC=
BANK_TRANSFER_BANK_NAME=

# Optional: retain only while pre-migration Mollie payments are pending.
MOLLIE_API_KEY=

SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=your-google-client-id
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=your-google-client-secret
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GOOGLE_ADS_ID=AW-18397712539

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Premier Brique <no-reply@your-domain.com>
