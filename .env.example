# Copy this file to .env only for local development. Never commit real credentials.
DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# Set to the final https domain once connected. Leave empty initially on Railway.
SITE_URL=
# Additional hostnames and their matching CSRF origins, if needed.
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# Activate only after the matching methods are enabled in Mollie and a live key is set.
# Mollie handles both credit cards and SEPA bank transfers.
MOLLIE_PAYMENTS_ENABLED=false
MOLLIE_API_KEY=live_replace_me
# Optional overrides; normally SITE_URL or the current request is used.
MOLLIE_WEBHOOK_URL=
MOLLIE_REDIRECT_BASE_URL=

SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=your-google-client-id
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=your-google-client-secret
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Premier Brique <no-reply@your-domain.com>
