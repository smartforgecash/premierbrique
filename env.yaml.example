# Copy to env.yaml, fill in real values, then deploy with:
#   gcloud run deploy premierbrique --source . --env-vars-file env.yaml ...
# env.yaml is gitignored. Keep it out of the repo and out of the Docker image.
DEBUG: "false"
DJANGO_SECRET_KEY: "generate-a-new-50-char-random-string"
DATABASE_URL: "postgres://USER:PASSWORD@HOST:PORT/DBNAME"

CARD_PAYMENTS_ENABLED: "false"
STRIPE_PUBLISHABLE_KEY: ""
STRIPE_SECRET_KEY: ""
STRIPE_WEBHOOK_SECRET: ""

BANK_TRANSFER_ACCOUNT_HOLDER: "Premiere brique"
BANK_TRANSFER_IBAN: "IE70SUMU99036513167213"
BANK_TRANSFER_BIC: ""
BANK_TRANSFER_BANK_NAME: "SumUp"

SOCIAL_AUTH_GOOGLE_OAUTH2_KEY: ""
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET: ""
GOOGLE_ANALYTICS_ID: ""

EMAIL_BACKEND: "django.core.mail.backends.smtp.EmailBackend"
EMAIL_HOST: ""
EMAIL_PORT: "587"
EMAIL_HOST_USER: ""
EMAIL_HOST_PASSWORD: ""
EMAIL_USE_TLS: "true"
DEFAULT_FROM_EMAIL: "Premier Brique <no-reply@premierbrique.com>"
